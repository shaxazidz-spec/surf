if data[uid]["index"] >= len(LESSONS.get(data[uid]["level"], [])):
            data[uid]["index"] = len(LESSONS.get(data[uid]["level"], [])) - 1
            save_data(data)
            await query.edit_message_text("Bu darjaning oxiri — keyinroq boshqa dars qo‘shiladi. Menuga qaytish uchun tugmani bosing.", reply_markup=main_menu_keyboard())
            return
        save_data(data)
        await send_lesson_for_user(uid, query, context)
        return

    # ortga
    if payload == "prev":
        data[uid]["index"] = data[uid].get("index", 0) - 1
        if data[uid]["index"] < 0:
            data[uid]["index"] = 0
            save_data(data)
            await query.answer("Bu dars birinchi dars.", show_alert=False)
            await send_lesson_for_user(uid, query, context)
            return
        save_data(data)
        await send_lesson_for_user(uid, query, context)
        return

    # tarjima tugmalari
    if payload.startswith("translate_"):
        dest = payload.split("_", 1)[1]  # en/de/uz
        last_text = data[uid].get("last_text", "")
        if not last_text:
            await query.edit_message_text("Tarjima uchun matn topilmadi. Avval darsni oching.", reply_markup=main_menu_keyboard())
            return
        try:
            translated = translator.translate(last_text, dest=dest).text
        except Exception as e:
            translated = f"Tarjima xatosi: {e}"
        await query.edit_message_text(f"Tarjima ({dest}):\n\n{translated}", reply_markup=main_menu_keyboard())
        return


# --- matnli xabarlar uchun handler ---
async def text_message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    uid = str(user.id)
    data = load_data()
    if uid not in data:
        data[uid] = {"lang": "english", "level": "A1", "index": 0, "last_text": ""}
        save_data(data)

    text = update.message.text.strip()

    # agar foydalanuvchi "translate english: ... " yuborsa
    lowered = text.lower()
    if lowered.startswith("translate ") or lowered.startswith("/t "):
        parts = text.split(" ", 2)
        if len(parts) >= 3:
            dest = parts[1].lower()
            body = parts[2]
            dest_code = LANG_MAP.get(dest, dest)
            try:
                translated = translator.translate(body, dest=dest_code).text
            except Exception as e:
                translated = f"Tarjima xatosi: {e}"
            await update.message.reply_text(f"Tarjima ({dest_code}):\n\n{translated}")
            return

    # oddiy matnga javob
    await update.message.reply_text(
        "Menyu orqali darajani tanlang yoki matnni tarjima qiling:\n"
        "translate english: Salom kabi formatda (quotemark ishlatmasdan).\n\n"
        "Boshlash uchun /start ni bosing.",
        reply_markup=main_menu_keyboard(),
    )


# --- ishga tushirish ---
def main():
    token = os.environ.get("BOT_TOKEN")
    if not token:
        print("Iltimos BOT_TOKEN muhit o'zgaruvchisini o'rnating.")
        return

    app = ApplicationBuilder().token(token).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_message_handler))

    # WEBHOOK ni sozlash: agar WEBHOOK_URL muhit o'zgaruvchisi berilgan bo'lsa — webhook ishlatamiz
    webhook_url = os.environ.get("WEBHOOK_URL")  # masalan: https://your-app.onrender.com
    port = int(os.environ.get("PORT", "8443"))
    if webhook_url:
        # URL path sifatida token ishlatish — xavfsizlik uchun oddiy chora
        url_path = token
        full_webhook = f"{webhook_url.rstrip('/')}/{url_path}"
        print("Webhook mode. Setting webhook to:", full_webhook)
        # run_webhook bilan botni ishga tushuramiz
        app.run_webhook(
            listen="0.0.0.0",
            port=port,
            url_path=url_path,
            webhook_url=full_webhook,
        )
    else:
        print("Polling mode (WEBHOOK_URL not set).")
        app.run_polling()
